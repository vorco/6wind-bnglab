#cloud-config
# 6WIND VSR first-boot configuration (NoCloud), generated by 6wind-bnglab.
# The VSR names ports by guest PCI location (pci-b<bus>s<slot>), which depends on
# the VM's shape, so the management port is found by its MAC address before the
# Day-1 file is written. cloud-init-per makes this run on the first boot only.
bootcmd:
  - - cloud-init-per
    - instance
    - bnglab-day1
    - /bin/sh
    - -c
    - |
      set -e
      mac={{ lab_vms_vsr_mac }}
      bdf=
      for d in /sys/bus/pci/devices/*; do
        for a in "$d"/net/*/address "$d"/virtio*/net/*/address; do
          if [ -r "$a" ] && [ "$(cat "$a")" = "$mac" ]; then bdf=${d##*/}; fi
        done
      done
      if [ -z "$bdf" ]; then echo "bnglab: no NIC with MAC $mac" >&2; exit 1; fi
      bus=$((0x$(echo "$bdf" | cut -d: -f2)))
      slot=$((0x$(echo "$bdf" | cut -d: -f3 | cut -d. -f1)))
      mkdir -p /etc/init-config
      sed "s/@MGMT_PORT@/pci-b${bus}s${slot}/" > /etc/init-config/config.cli <<'CLI'
      / system hostname bnglab-vsr
      / system timezone {{ lab_mgmt.timezone }}
      / vrf mgmt interface physical mgmt port @MGMT_PORT@
      / vrf mgmt interface physical mgmt ipv4 address {{ lab_mgmt.vsr_ip }}/{{ lab_mgmt.prefix }}
      / vrf mgmt routing static ipv4-route 0.0.0.0/0 next-hop {{ lab_mgmt.gateway }}
{% for server in lab_mgmt.dns %}
      / vrf mgmt dns server {{ server }}
{% endfor %}
{% for server in lab_mgmt.ntp %}
      / vrf mgmt ntp time-sources server {{ server }}
{% endfor %}
      / vrf mgmt netconf-server enabled true
      / vrf mgmt ssh-server enabled true
      / vrf mgmt ssh-server permit-root-login yes
      / vrf main netconf-server enabled false
      / system auth user {{ vsr_admin_user }} role admin
      / system auth user {{ vsr_admin_user }} password {{ lab_vms_vsr_password_hash }}
{% for key in lab_ssh_public_keys %}
      / system auth user {{ vsr_admin_user }} authorized-key "{{ key }}"
{% endfor %}
      / system auth default-users-enabled false
      / system license online serial {{ vsr_license_serial }}
      / system license online vrf mgmt
      / system fast-path core-mask exception 0
      / system fast-path core-mask fast-path 1-{{ lab_vms_vsr_cores | int - 1 }}
      CLI
